---
import { url } from '../lib/paths';
---

<section class="tint" id="news">
	<div class="wrap">
		<div class="ov">Our Partners</div>
		<div class="quote">
			<div class="qmark">&ldquo;</div>
			<blockquote>
				Higala and RCBC share a vision of a country where finance is accessible to all, enabling
				dreams and aspirations. By forging this partnership, RCBC is proud to advance our financial
				inclusion efforts, creating more opportunities for entrepreneurs and consumers to experience
				fun, hassle-free, and empowering banking.
			</blockquote>
			<div class="byline">
				<div class="avatar">
					<img src={url('/testimonials/lito-villanueva.jpg')} alt="Lito Villanueva" />
				</div>
				<div>
					<b>Lito Villanueva</b>
					<span>EVP and Chief Innovation and Inclusion Officer, RCBC</span>
				</div>
			</div>
		</div>
	</div>
</section>
