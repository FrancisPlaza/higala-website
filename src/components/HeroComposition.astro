---
// Home-hero visual: capability chips (left) + phone-mockup stage (center) + capability cards (right).
const leftChips = [
	{
		label: 'API',
		path: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h6v6H9zM9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3"/>',
	},
	{
		label: 'InstaPay Rail',
		path: '<path d="M8 3L4 7l4 4"/><path d="M4 7h16"/><path d="M16 21l4-4-4-4"/><path d="M20 17H4"/>',
	},
	{
		label: 'Ecosystem',
		path: '<circle cx="12" cy="12" r="3"/><circle cx="5" cy="5" r="2.4"/><circle cx="19" cy="5" r="2.4"/><circle cx="5" cy="19" r="2.4"/><circle cx="19" cy="19" r="2.4"/><path d="M6.8 6.8l2.8 2.8M17.2 6.8l-2.8 2.8M6.8 17.2l2.8-2.8M17.2 17.2l-2.8-2.8"/>',
	},
];

const rightCards = [
	{ label: 'Deposits', path: '<rect x="2" y="6" width="20" height="13" rx="2.5"/><path d="M2 11h20M6 15h4"/>' },
	{ label: 'Lending', path: '<path d="M3 17l6-6 4 4 8-8"/><path d="M21 7v6h-6"/>' },
	{
		label: 'Payments',
		path: '<path d="M7 4L3 8l4 4"/><path d="M3 8h13"/><path d="M17 20l4-4-4-4"/><path d="M21 16H8"/>',
	},
	{
		label: 'Platform Banking',
		path: '<path d="M3 21h18M5 21V10M19 21V10M12 3l9 5H3z"/><path d="M9 21v-6h6v6"/>',
	},
];

const transactions = [
	{
		icon: '<path d="M17 7L7 17M15 17H7V9"/>',
		who: 'Loan repayment',
		when: 'Today, 10:40 AM',
		amount: '−₱2,400',
		in: false,
	},
	{
		icon: '<path d="M7 17L17 7M9 7h8v8"/>',
		who: 'Loan release',
		when: 'Yesterday',
		amount: '+₱38,200',
		in: true,
	},
	{
		icon: '<path d="M17 7L7 17M15 17H7V9"/>',
		who: 'Loan repayment',
		when: '18 Aug',
		amount: '−₱1,000',
		in: false,
	},
];
---

<div class="comp">
	<div class="comp-col">
		{
			leftChips.map((c) => (
				<div class="chip">
					<svg viewBox="0 0 24 24" set:html={c.path} />
					<span>{c.label}</span>
				</div>
			))
		}
	</div>

	<div class="stage">
		<div class="phone" role="img" aria-label="A digital banking app showing an available balance and recent loan repayments">
			<div class="scr">
				<div class="scr-top">
					<span>9:41</span>
					<i><b></b><b></b><b></b></i>
				</div>
				<p class="greet">Good morning, <b>Maya</b></p>

				<div class="bal">
					<div class="lab">Available balance</div>
					<div class="amt">₱128,450<em>.00</em></div>
					<div class="row"><span>•••• 8042</span></div>
				</div>

				<div class="acts">
					<div><span><svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8"></path></svg></span>Send</div>
					<div><span><svg viewBox="0 0 24 24"><path d="M17 7L7 17M15 17H7V9"></path></svg></span>Receive</div>
					<div><span><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg></span>Pay</div>
				</div>

				<div class="act-h">Recent activity</div>
				<div class="txs">
					{
						transactions.map((t) => (
							<div class="tx">
								<span class="ico">
									<svg viewBox="0 0 24 24" set:html={t.icon} />
								</span>
								<span class="who">
									<b>{t.who}</b>
									<span>{t.when}</span>
								</span>
								<span class:list={['amt2', { in: t.in }]}>{t.amount}</span>
							</div>
						))
					}
				</div>

				<div class="tabs-m">
					<svg class="on" viewBox="0 0 24 24"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"></path></svg>
					<svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8"></path></svg>
					<svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20V8"></path></svg>
					<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21v-1a6 6 0 0 1 16 0v1"></path></svg>
				</div>
				<div class="grip"></div>
			</div>
		</div>
	</div>

	<div class="comp-col">
		{
			rightCards.map((c) => (
				<div class="cap">
					<svg viewBox="0 0 24 24" set:html={c.path} />
					<span>{c.label}</span>
				</div>
			))
		}
	</div>
</div>

<style>
	.comp {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: clamp(10px, 1.6vw, 20px);
		align-items: center;
	}
	.comp-col {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.chip {
		width: 70px;
		padding: 14px 6px;
		border-radius: var(--radius-card);
		text-align: center;
		background: rgba(18, 36, 36, 0.34);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.24);
		backdrop-filter: blur(8px);
	}
	.chip svg {
		width: 22px;
		height: 22px;
		stroke: #fff;
		stroke-width: 1.8;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		margin: 0 auto 8px;
		display: block;
	}
	.chip span {
		display: block;
		font: 600 9.5px var(--font-body);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.9);
		line-height: 1.25;
	}

	/* stage: photo frame housing the phone mockup */
	.stage {
		position: relative;
		border-radius: var(--radius-media);
		overflow: hidden;
		background: linear-gradient(155deg, rgba(18, 36, 36, 0.3), rgba(255, 255, 255, 0.1) 55%, rgba(0, 222, 105, 0.2));
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.28), var(--shadow-lg);
		min-width: 0;
		display: grid;
		place-items: center;
		aspect-ratio: 1/1.26;
		container-type: size;
	}
	.stage:before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: repeating-linear-gradient(122deg, rgba(255, 255, 255, 0.06) 0 1px, transparent 1px 44px);
	}

	/* phone mockup — scales with the frame via container query units */
	.phone {
		position: relative;
		z-index: 2;
		display: flex;
		height: 92cqh;
		width: auto;
		aspect-ratio: 210/387;
		border-radius: 11cqw;
		padding: 2.1cqw;
		background: linear-gradient(160deg, #1d3535, #0b1c1c);
		box-shadow: 0 6cqw 12cqw rgba(9, 20, 20, 0.42), inset 0 0 0 0.3cqw rgba(255, 255, 255, 0.14);
	}
	.scr {
		background: #fff;
		border-radius: 9cqw;
		padding: 3.4cqw 3.4cqw 2.6cqw;
		overflow: hidden;
		flex: 1 1 auto;
		display: flex;
		flex-direction: column;
	}
	.scr-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font: 600 2.3cqw var(--font-mono);
		color: var(--ink-400);
		margin-bottom: 2.6cqw;
	}
	.scr-top i {
		display: flex;
		gap: 0.7cqw;
		font-style: normal;
	}
	.scr-top i b {
		display: block;
		width: 1cqw;
		height: 1cqw;
		border-radius: 50%;
		background: var(--ink-400);
	}
	.greet {
		font: 400 3.3cqw var(--font-body);
		color: var(--ink-500);
		margin: 0 0 2.4cqw;
	}
	.greet b {
		font-family: var(--font-display);
		font-weight: 600;
		color: var(--ink);
	}

	.bal {
		background: var(--grad-brand);
		border-radius: 4.4cqw;
		padding: 3.4cqw;
		color: #fff;
		box-shadow: 0 2cqw 5cqw rgba(0, 168, 160, 0.3);
	}
	.bal .lab {
		font: 600 2.3cqw var(--font-body);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.82);
	}
	.bal .amt {
		font: 700 6.4cqw/1 var(--font-display);
		letter-spacing: -0.02em;
		margin: 1.4cqw 0 2.4cqw;
		font-variant-numeric: tabular-nums;
	}
	.bal .amt em {
		font-style: normal;
		font-size: 3.6cqw;
	}
	.bal .row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font: 500 2.5cqw var(--font-mono);
		color: rgba(255, 255, 255, 0.88);
	}

	.acts {
		display: flex;
		justify-content: space-between;
		margin: 2.8cqw 1cqw 2.2cqw;
	}
	.acts div {
		text-align: center;
		font: 500 2.4cqw var(--font-body);
		color: var(--ink-500);
	}
	.acts span {
		display: grid;
		place-items: center;
		width: 8.4cqw;
		height: 8.4cqw;
		border-radius: 50%;
		background: var(--higala-teal-050);
		margin: 0 auto 1.2cqw;
	}
	.acts svg {
		width: 3.6cqw;
		height: 3.6cqw;
		stroke: var(--higala-teal-700);
		stroke-width: 2;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.act-h {
		font: 600 2.6cqw var(--font-body);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink-400);
		margin-bottom: 1.6cqw;
	}
	.txs {
		flex: 1 1 auto;
		min-height: 0;
		overflow: hidden;
	}
	.tx {
		display: flex;
		align-items: center;
		gap: 2.2cqw;
		padding: 1.5cqw 0;
		border-top: 0.22cqw solid var(--line-soft);
	}
	.tx .ico {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: 6.6cqw;
		height: 6.6cqw;
		border-radius: 2cqw;
		background: var(--higala-teal-050);
	}
	.tx .ico svg {
		width: 3cqw;
		height: 3cqw;
		stroke: var(--higala-teal-700);
		stroke-width: 2;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.tx .who {
		flex: 1 1 auto;
		min-width: 0;
	}
	.tx .who b {
		display: block;
		font: 600 2.9cqw var(--font-body);
		color: var(--ink);
	}
	.tx .who span {
		font: 400 2.4cqw var(--font-body);
		color: var(--ink-400);
	}
	.tx .amt2 {
		font: 600 2.9cqw var(--font-mono);
		color: var(--ink);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.tx .amt2.in {
		color: var(--higala-green-700);
	}

	.tabs-m {
		flex: 0 0 auto;
		margin-top: auto;
		padding-top: 2.2cqw;
		display: flex;
		justify-content: space-around;
		border-top: 0.22cqw solid var(--line-soft);
	}
	.tabs-m svg {
		width: 3.6cqw;
		height: 3.6cqw;
		stroke: var(--ink-400);
		stroke-width: 2;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.tabs-m svg.on {
		stroke: var(--higala-teal);
	}
	.grip {
		flex: 0 0 auto;
		width: 22%;
		height: 0.8cqw;
		border-radius: 1cqw;
		background: var(--line);
		margin: 1.8cqw auto 0;
	}

	.cap {
		width: 114px;
		background: #fff;
		border-radius: var(--radius-card);
		padding: 16px 14px;
		box-shadow: var(--shadow-md);
		transition: transform var(--dur-base) var(--ease);
	}
	.cap:hover {
		transform: translateY(-2px);
	}
	.cap svg {
		width: 22px;
		height: 22px;
		stroke: var(--higala-teal);
		stroke-width: 1.9;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		margin-bottom: 10px;
		display: block;
	}
	.cap span {
		font: 600 11.5px var(--font-body);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink);
		line-height: 1.3;
		display: block;
	}

	@media (max-width: 1080px) {
		.comp {
			max-width: 640px;
			margin: 0 auto;
		}
		.cap {
			width: 112px;
		}
		.chip {
			width: 70px;
		}
	}

	@media (max-width: 760px) {
		.comp {
			display: flex;
			flex-direction: column;
			gap: 14px;
			max-width: none;
		}
		.comp-col {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 10px;
			justify-content: center;
		}
		.chip,
		.cap {
			width: calc(50% - 5px);
			display: flex;
			align-items: center;
			gap: 10px;
			text-align: left;
		}
		.chip svg,
		.cap svg {
			margin: 0;
			flex: 0 0 auto;
		}
		.chip {
			padding: 12px 14px;
		}
		.cap {
			padding: 14px;
		}
		.stage {
			order: -1;
			width: 100%;
			aspect-ratio: 1/1.18;
		}
	}

	@media (max-width: 420px) {
		.chip,
		.cap {
			width: 100%;
		}
	}
</style>
