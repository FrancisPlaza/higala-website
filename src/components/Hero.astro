---
const hasVisual = Astro.slots.has('visual');
const hasTrust = Astro.slots.has('trust');
---

<section class="hero on-ink">
	<div class="wrap">
		{
			hasVisual ? (
				<div class="hero-grid">
					<div class="hero-copy">
						<div class="ov ov-hero">
							<slot name="eyebrow" />
						</div>
						<h1><slot name="heading" /></h1>
						<p class="lede"><slot name="lede" /></p>
						<div class="cta-row" style="margin-top:40px">
							<slot name="cta" />
						</div>
					</div>
					<slot name="visual" />
				</div>
			) : (
				<div class="hero-copy">
					<div class="ov"><slot name="eyebrow" /></div>
					<h1><slot name="heading" /></h1>
					<p class="lede"><slot name="lede" /></p>
					<div class="cta-row" style="margin-top:40px">
						<slot name="cta" />
					</div>
				</div>
			)
		}
		{
			hasTrust && (
				<div class="trust">
					<slot name="trust" />
				</div>
			)
		}
	</div>
</section>

<style>
	.hero {
		background: var(--grad-brand-deep);
		padding: 88px 0 80px;
		position: relative;
		overflow: hidden;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.98fr) minmax(0, 1.02fr);
		gap: clamp(24px, 3vw, 44px);
		align-items: center;
	}
	.hero-grid .hero-copy {
		min-width: 0;
	}
	.hero:after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(120% 80% at 85% 10%, rgba(255, 255, 255, 0.14), transparent 60%);
		pointer-events: none;
	}
	.hero .wrap {
		position: relative;
		z-index: 1;
	}
	.hero h1 {
		max-width: 16ch;
		font-size: clamp(32px, 4.4vw, 58px);
		line-height: 1.04;
	}
	.hero .lede {
		max-width: 52ch;
		font-size: clamp(16px, 1.35vw, 19px);
	}
	.trust {
		margin-top: 52px;
		padding-top: 22px;
		border-top: 1px solid rgba(255, 255, 255, 0.22);
		font-size: 14px;
		color: rgba(255, 255, 255, 0.72);
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}
	.trust span:not(:last-child):after {
		content: ' \00b7';
		margin-left: 10px;
		color: rgba(255, 255, 255, 0.4);
	}

	@media (max-width: 1080px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 44px;
		}
		.hero h1,
		.hero .lede {
			max-width: none;
		}
	}
	@media (max-width: 760px) {
		.hero {
			padding: 56px 0 60px;
		}
		.trust {
			margin-top: 36px;
			font-size: 13px;
			flex-direction: column;
			gap: 8px;
		}
		.trust span:not(:last-child):after {
			content: '';
		}
	}
</style>
