---
import ArrowRight from './icons/ArrowRight.astro';
import { demoSchedulingUrl } from '../lib/paths';

interface Props {
	id?: string;
	heading: string;
	body: string;
	primaryLabel?: string;
	primaryHref?: string;
	secondaryLabel?: string;
	secondaryHref?: string;
}
const {
	id,
	heading,
	body,
	primaryLabel = 'Book a Demo',
	primaryHref = demoSchedulingUrl,
	secondaryLabel = 'Or send us a DM',
	secondaryHref = '#',
} = Astro.props;
---

<section id={id}>
	<div class="wrap">
		<div class="ctapanel">
			<h2>{heading}</h2>
			<p>{body}</p>
			<div class="cta-row" style="margin-top:36px">
				<a class="btn btn-white" href={primaryHref} target="_blank" rel="noopener noreferrer">{primaryLabel}</a>
				<a class="tlink" style="color:#fff" href={secondaryHref}>
					{secondaryLabel}
					<ArrowRight />
				</a>
			</div>
		</div>
	</div>
</section>
